{
  "name": "trackdoc",
  "private": true,
  "version": "0.2.1",
  "description": "Editor e player de tours com captura de tela",
  "license": "MIT",
  "main": "electron/main.js",
  "scripts": {
    "prestart": "npm run build:dock && npm run pack:extension && node scripts/copy-tts-runtime.mjs",
    "start": "node scripts/dev-server.mjs",
    "pretest": "node scripts/copy-tts-runtime.mjs",
    "vercel-build": "npm run build:dock && npm run pack:extension && node scripts/copy-tts-runtime.mjs",
    "build:dock": "vite build",
    "typecheck": "tsc --noEmit",
    "dev:dock": "vite build --watch",
    "pack:extension": "node scripts/pack-extension.mjs",
    "test": "node --test extension/lib/*.test.js scripts/*.test.js js/*.test.js electron/secret-store.test.js",
    "desktop": "electron .",
    "predesktop": "npm run build:dock && npm run pack:extension && node scripts/copy-tts-runtime.mjs",
    "pre-dist:desktop": "npm run build:dock && npm run pack:extension && node scripts/copy-tts-runtime.mjs",
    "dist:desktop": "electron-builder --dir"
  },
  "devDependencies": {
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "archiver": "^8.0.0",
    "electron": "^36.4.0",
    "electron-builder": "^26.0.12",
    "espeak-ng": "^1.0.2",
    "kokoro-js": "^1.2.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.3"
  },
  "build": {
    "appId": "app.trackdoc",
    "productName": "TrackDoc",
    "directories": {
      "output": "release"
    },
    "files": [
      "index.html",
      "view.html",
      "ajuda.html",
      "favicon.*",
      "trackdocs-*.svg",
      "apple-touch-icon.png",
      "og-share.svg",
      "downloads/trackdoc-captura.zip",
      "js/dock-runtime/**/*",
      "css/**/*",
      "js/**/*",
      "data/**/*",
      "demo/**/*",
      "vendor/**/*",
      "extension/content.js",
      "extension/lib/demo-payload.js",
      "electron/**/*",
      "package.json"
    ],
    "mac": {
      "target": [
        "dir"
      ],
      "identity": null
    },
    "linux": {
      "target": [
        "dir"
      ]
    },
    "win": {
      "target": [
        "dir"
      ]
    }
  },
  "dependencies": {
    "@vercel/blob": "^2.8.0",
    "clsx": "^2.1.1",
    "framer-motion": "^14.0.0",
    "lucide-react": "^1.52.0",
    "motion": "^14.0.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tailwind-merge": "^3.7.0"
  }
}
